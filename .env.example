# Copier ce fichier en .env.local et le remplir soi-même.
# Supabase > Project Settings > API Keys : « Publishable key » (sb_publishable_…) et « Secret key » (sb_secret_…)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secrète : jamais côté navigateur, jamais dans git.
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
GEMINI_API_KEY=
# Modèle cité par le SDK installé ; vérifier sa disponibilité gratuite dans Google AI Studio.
GEMINI_MODEL=gemini-3.8-flash
# 1 = IA factice (tests et dev sans clé)
AI_FAKE=1
# Délai minimal entre deux appels IA en file (quota gratuit)
AI_INTERVALLE_MS=6000
